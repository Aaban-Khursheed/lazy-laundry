{
  "name": "lazy-laundry",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:ui": "esbuild src/booking/app.js src/operator/app.js --bundle --format=esm --target=es2022 --minify --legal-comments=none --outbase=src --outdir=public",
    "predev": "npm run build:ui",
    "dev": "wrangler dev --env local",
    "pretest:e2e": "npm run build:ui",
    "predeploy:dry-run": "npm run build:ui && npm run lint && npm run test",
    "predeploy": "npm run build:ui && npm run lint && npm run test",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:infra": "vitest run --config testing/vitest.config.mjs",
    "test:integration": "vitest run --config testing/vitest.integration.config.mjs",
    "db:check": "node scripts/check-migrations.mjs",
    "evidence": "node scripts/collect-evidence.mjs",
    "pretest:e2e:infra": "npm run build:ui",
    "test:e2e:infra": "playwright test --config testing/playwright.config.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run --env=\"\"",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.1",
    "eslint": "10.12.0",
    "globals": "^17.13.0",
    "vitest": "5.0.3",
    "wrangler": "4.151.2"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1"
  }
}
