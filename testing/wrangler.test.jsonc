{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "liberait-lazy-laundry-test",
  "main": "../api/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENVIRONMENT": "local",
    "PUBLIC_BOOKING_ENABLED": "true",
    "PRICE_REVISION": "launch-v1",
    "TERMS_POLICY_VERSION": "launch-v2",
    "BOOKING_LEAD_MINUTES": "60",
    "ACTIVE_BOOKING_LIMIT": "2",
    "CUSTOMER_HOSTS": "localhost,127.0.0.1",
    "OPERATOR_HOST": "ops.localhost",
    "LOCAL_OPERATOR_EMAIL": "local.operator@example.invalid",
    "OPERATOR_ALLOWED_EMAILS": "local.operator@example.invalid",
    "OPERATOR_ALERT_EMAIL": "local.operator@example.invalid",
    "TURNSTILE_SITEKEY": "",
    "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1",
    "SERVICE_TIMEZONE": "Asia/Kuala_Lumpur",
    "PICKUP_SLOTS_WEEKDAY": "19:00,20:00,21:00",
    "PICKUP_SLOTS_WEEKEND": "10:00,11:00,12:00,19:00,20:00,21:00"
  },
  "secrets": {
    "required": ["TRACKING_TOKEN_ENCRYPTION_KEY"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "liberait-test-only",
    "database_id": "liberait-test-only",
    "remote": false,
    "migrations_dir": "../api/migrations"
  }],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "RATE_LIMITER_BOOKING",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
